---
import { statistiky } from '../data/content';
---

<section class="bg-brand">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h2 class="text-center font-heading text-[26px] text-white md:text-[42px]">{statistiky.nadpis}</h2>
    <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {
        statistiky.polozky.map((polozka) => (
          <div class="rounded-[20px] bg-white px-4 py-6 text-center shadow-md">
            <p class="font-heading text-[32px] font-bold leading-none text-brand md:text-[38px]">{polozka.cislo}</p>
            <p class="mt-2 text-[16px] text-neutral-900 md:text-[18px]">{polozka.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
