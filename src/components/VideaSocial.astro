---
import { videa } from '../data/content';
import { site } from '../data/site';
import YouTubeFacade from './YouTubeFacade.astro';
---

<section class="bg-brand">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <div class="grid items-stretch gap-8 md:grid-cols-2">
      <div class="flex flex-col">
        <p class="text-[22px] font-bold text-neutral-900 md:text-[25px]">{videa.nadpis}</p>
        <p class="mt-4 text-[18px] text-neutral-900">{videa.text}</p>
        <div class="mt-6 flex items-center gap-4">
          <a href={site.socialne.instagram} target="_blank" rel="noopener" aria-label="Instagram DDelux">
            <img src="/images/instagram.svg" alt="" width="40" height="40" class="h-10 w-10 transition hover:opacity-70" loading="lazy" />
          </a>
          <a href={site.socialne.facebook} target="_blank" rel="noopener" aria-label="Facebook DDelux">
            <img src="/images/facebook.svg" alt="" width="40" height="40" class="h-10 w-10 transition hover:opacity-70" loading="lazy" />
          </a>
        </div>
        <YouTubeFacade videoId={videa.videoIds[0]} title="DDelux — ukážka práce 1" class="mt-8 aspect-video" />
      </div>
      <div class="grid grid-cols-2 gap-5">
        <YouTubeFacade videoId={videa.videoIds[1]} title="DDelux — ukážka práce 2" class="aspect-[9/16]" />
        <YouTubeFacade videoId={videa.videoIds[2]} title="DDelux — ukážka práce 3" class="aspect-[9/16]" />
      </div>
    </div>
  </div>
</section>
