---
import { zaruka } from '../data/content';
---

<section class="bg-brand">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h2 class="text-center font-heading text-[28px] font-normal text-white md:text-[42px]">{zaruka.nadpis}</h2>
    <div class="mt-10 grid items-center gap-8 md:grid-cols-[1fr_2.2fr] md:gap-16">
      <div class="grid content-center gap-6">
        {
          zaruka.polozky.map((polozka) => (
            <div class="rounded-2xl border-2 border-white px-6 py-5 text-center">
              <h3 class="font-heading text-[19px] font-bold text-neutral-900">{polozka.titulok}</h3>
              <p class="mt-3 text-[16px] leading-snug text-neutral-900">{polozka.text}</p>
            </div>
          ))
        }
      </div>
      <img
        src={zaruka.obrazok.src}
        alt={zaruka.obrazok.alt}
        width={zaruka.obrazok.width}
        height={zaruka.obrazok.height}
        class="w-full"
        loading="lazy"
      />
    </div>
  </div>
</section>
