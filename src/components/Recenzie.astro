---
import { recenzie } from '../data/content';
---

<section class="bg-black">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <div class="flex flex-col items-center justify-center gap-6 md:flex-row">
      <h2 class="text-center font-heading text-[26px] font-bold text-white md:text-[42px]">{recenzie.nadpis}</h2>
      <img
        src={recenzie.googleObrazok.src}
        alt={recenzie.googleObrazok.alt}
        width={recenzie.googleObrazok.width}
        height={recenzie.googleObrazok.height}
        class="rounded-lg"
        loading="lazy"
      />
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-x-10">
      {
        recenzie.polozky.map((polozka) => (
          <figure class="rounded-xl border border-brand bg-black p-6">
            <figcaption class="flex items-center gap-6">
              <span class="font-heading text-[19px] font-bold text-white">{polozka.meno}</span>
              <span class="text-[18px] tracking-wider text-brand" aria-label="5 z 5 hviezdičiek">
                ★★★★★
              </span>
            </figcaption>
            <blockquote class="mt-4 text-[17px] leading-[1.5] text-white">{polozka.text}</blockquote>
          </figure>
        ))
      }
    </div>
  </div>
</section>
