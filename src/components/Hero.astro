---
import { hero } from '../data/content';
import YouTubeFacade from './YouTubeFacade.astro';
---

<section class="bg-black">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-[2fr_3fr] md:py-20">
    <div>
      <h1 class="font-heading text-[36px] font-bold leading-[1.3] md:text-[46px]">
        <span class="text-brand">{hero.nadpisModra}</span><br />
        <span class="whitespace-pre-line text-white">{hero.nadpisBiela}</span>
      </h1>
      <p class="mt-6 text-[20px] text-white md:text-[25px]">{hero.podnadpis}</p>
      <button
        type="button"
        data-popup-open
        class="mt-10 inline-block cursor-pointer rounded-md bg-brand px-8 py-3 text-[20px] font-bold text-white transition hover:bg-brand/85"
      >
        {hero.cta}
      </button>
    </div>
    <YouTubeFacade
      videoId={hero.videoId}
      title="DDelux — prémiová starostlivosť o vaše auto"
      class="aspect-video rounded-2xl"
    />
  </div>
</section>
