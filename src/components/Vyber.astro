---
import { vyber } from '../data/content';
---

<section class="bg-black">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 md:flex-row md:items-center md:justify-between md:py-16">
    <div>
      <h2 class="font-heading text-[24px] font-bold text-white md:text-[28px]">{vyber.nadpis}</h2>
      <p class="mt-3 text-[18px] text-brand">{vyber.text}</p>
    </div>
    <button
      type="button"
      data-popup-open
      class="shrink-0 cursor-pointer self-start rounded-[10px] bg-brand px-6 py-3 text-[18px] font-bold text-white transition hover:bg-brand/85 md:self-center"
    >
      {vyber.cta}
    </button>
  </div>
</section>
